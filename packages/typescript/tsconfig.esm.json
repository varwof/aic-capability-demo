{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "typeRoots": ["../../ts/node_modules/@types"],
    "strict": true,
    "rootDir": "../..",
    "outDir": "dist/esm",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "../../ts/clc_semantics.ts",
    "../../ts/evidence_semantics.ts",
    "../../ts/ocmp.ts",
    "../../ts/scheme_decl.ts"
  ]
}
